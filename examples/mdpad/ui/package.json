{
  "name": "mdpad-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The mdpad web client: the editor page, its websocket provider and the Node tests of both",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build",
    "mock": "node mock/server.mjs",
    "lint": "eslint src tests tests-live",
    "fixtures": "node tests-node/fixtures.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "tsc -p tsconfig.node.json && node --test 'tests-node/*.test.mjs' 'tests-node/*.test.ts'",
    "e2e": "playwright test",
    "e2e:live": "playwright test -c playwright.live.config.ts",
    "shots:live": "SHOTS=1 playwright test -c playwright.live.config.ts"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.14.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "^6.7.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.103.1",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "lib0": "0.2.119",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "morphdom": "^2.7.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "y-codemirror.next": "^0.3.5",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.6",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "ws": "^8.18.3"
  }
}
