{
  "name": "edge-workers-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:mock": "EDGE_MOCK=1 vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "mock": "node mock/server.mjs",
    "lint": "eslint src tests tests-live",
    "e2e": "playwright test",
    "e2e:live": "playwright test -c playwright.live.config.ts",
    "shots:live": "SHOTS=1 playwright test -c playwright.live.config.ts"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.14.0",
    "@codemirror/lang-javascript": "^6.2.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/merge": "^6.7.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.26.0",
    "@lezer/highlight": "^1.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.103.1",
    "codemirror": "^6.0.1",
    "echarts": "^6.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  }
}
